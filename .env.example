# Copiar este archivo como .env si hace falta cambiar algo. El .env nunca se commitea.
# Con los valores por defecto la aplicación funciona sin .env.

# Archivo de la base SQLite. Si se omite, se usa vetsys.db en la raíz del repo.
# Una ruta relativa se interpreta desde la raíz del repo.
DATABASE_PATH=vetsys.db
