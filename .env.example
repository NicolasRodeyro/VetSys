# Copiar este archivo como .env y completar los valores. El .env nunca se commitea.

# Cadena del Session pooler de Supabase (o de un Postgres local para el plan B).
# Supabase:  postgresql://postgres.<id-proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local:     postgresql://postgres:postgres@localhost:5432/vetsys
DATABASE_URL=

# Clave para firmar la sesión de Flask (mensajes flash). Cualquier texto largo y aleatorio.
FLASK_SECRET_KEY=
